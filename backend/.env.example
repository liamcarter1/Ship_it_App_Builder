# Auth for the Claude Agent SDK.
# You can EITHER set this key here, OR run `claude` once interactively to
# log in with your subscription. Only one is needed.
ANTHROPIC_API_KEY=

# Optional: override the default models per role (see app/agents/*.py).
# Leave blank to use the SDK defaults.
PLANNER_MODEL=
CODER_MODEL=
ORCHESTRATOR_MODEL=
