# Auth for the Claude Agent SDK.
# You can EITHER set this key here, OR run `claude` once interactively to
# log in with your subscription. Only one is needed.
ANTHROPIC_API_KEY=

# Optional: override the default models per role (see app/agents/*.py).
# Leave blank to use the SDK defaults.
PLANNER_MODEL=
SCAFFOLDER_MODEL=
CODER_MODEL=
REVIEWER_MODEL=
DEPLOYER_MODEL=

# Required only when running with `--deploy` (Milestone 1 Deployer stage).
# A Vercel personal token: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Optional: relocate SQLite + workspaces. Defaults are <repo>/backend/shipit.db
# and <repo>/workspaces.
SHIPIT_DB=
SHIPIT_WORKSPACES=
